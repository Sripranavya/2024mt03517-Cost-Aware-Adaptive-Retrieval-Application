# ---------------------------------------------------------------------------
# Application settings (copy to .env for local development).
# Real .env is git-ignored. Only placeholders belong here.
# ---------------------------------------------------------------------------

# Runtime mode. When true, every AWS client is swapped for a local fake.
USE_LOCAL_MOCKS=true
APP_ENV=local
LOG_LEVEL=INFO

# CORS: exact frontend origin(s), comma separated. Never use "*".
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- POMDP / reward tuning (safe defaults; override for ablations) ---
MAX_HOPS=6
REWARD_QUALITY_WEIGHT=1.0
REWARD_COST_WEIGHT=0.15
REWARD_LATENCY_WEIGHT=0.05
REWARD_REDUNDANCY_WEIGHT=0.25
BELIEF_LEARNING_RATE=0.5
CONFIDENCE_STOP_THRESHOLD=0.85

# --- Cost model (published Bedrock-style per-1K-token prices, USD) ---
PRICE_PER_1K_INPUT_TOKENS=0.003
PRICE_PER_1K_OUTPUT_TOKENS=0.015

# --- Batch limits ---
MAX_BATCH_QUERIES=50

# --- AWS resource identifiers (CLOUD mode only; never hardcode in code) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=rag-documents
DYNAMODB_TABLE_NAME=agentic-rag-state
S3_BUCKET_NAME=agentic-rag-corpus
SQS_QUEUE_URL=
SNS_TOPIC_ARN=

# --- Cognito (CLOUD mode auth) ---
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=us-east-1

# --- Local auth (LOCAL mode only): symmetric signing secret for test JWTs ---
LOCAL_JWT_SECRET=local-development-only-not-a-real-secret
LOCAL_JWT_ISSUER=agentic-rag-local
JWT_AUDIENCE=agentic-rag-api
LOCAL_DEMO_PASSWORD=local-demo
JWT_EXPIRY_SECONDS=3600

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=30

# --- Local storage paths ---
LOCAL_DATA_DIR=./.localdata
FAISS_INDEX_PATH=./.localdata/faiss.index
SQLITE_PATH=./.localdata/state.sqlite
